// TITO KARAOKE STUDIO v2.0 — persistence schema
// PlayEvent: global play counter ("hot in the app").
// SyncCache: AI-computed preview sync offsets (keyed by preview URL hash),
// so the ASR alignment for a song runs once, ever.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PlayEvent {
  id         Int      @id @default(autoincrement())
  songKey    String
  title      String
  artist     String
  artwork    String   @default("")
  previewUrl String   @default("")
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([songKey, createdAt])
}

model SyncCache {
  id            String   @id // sha1(previewUrl)
  offsetSec     Float
  confidence    Float    @default(0)
  previewDurSec Float    @default(30)
  createdAt     DateTime @default(now())
}
